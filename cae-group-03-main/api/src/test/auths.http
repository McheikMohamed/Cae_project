@baseUrl = http://localhost:3000

### Create the first user
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "honorific": "Mme.",
  "firstName": "Marie",
  "lastName": "Dubois",
  "email": "marie.dubois89@valmont.be",
  "password": "Mdp.123!",
  "phoneNumber": "324745682",
  "role": "CLIENT",
  "company": "",
  "address": {
  "street": "Rue des Acacias",
  "number": "12",
  "box":"1",
  "postalCode": 6730,
  "city": "Valmont",
  "country": {
    "name": "Belgique"
    }
  }
}

> {%
  client.test("Request executed successfully", function() {
    client.assert(response.status === 200, "Response status is not 200");
  });

  client.test("Response content-type is json", function() {
    var type = response.contentType.mimeType;
    client.assert(type === "application/json", "Expected 'application/json' but received '" + type + "'");
  });
  client.test("Should return user data", function() {
    var body = response.body
    console.log(body);
    client.assert(body.email == "marie.dubois89@valmont.be");
    client.assert(body.firstName == "Marie" );
    client.assert(body.role == "CLIENT");
    client.assert(body.token)
  });
%}

### Login the default user
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "marie.dubois89@valmont.be",
  "password": "Mdp.123!"
}
> {%
  client.test("Request executed successfully", function() {
    client.assert(response.status === 200, "Response status is not 200");
  });

  client.test("Response content-type is json", function() {
    var type = response.contentType.mimeType;
    client.assert(type === "application/json", "Expected 'application/json' but received '" + type + "'");
  });
  client.test("Should return user data", function() {
    var body = response.body
    console.log(body);
    client.assert(body.email == "marie.dubois89@valmont.be");
    client.assert(body.firstName == "Marie" );
    client.assert(body.role == "CLIENT");
    client.assert(body.token)
    client.global.set("token",response.token)
  });
%}

