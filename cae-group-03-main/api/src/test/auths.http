### Update password with wrong oldPassword
PATCH {{baseUrl}}/auths/updatePassword
Content-Type: application/json

{
  "email": "marie.dubois89@valmont.be",
  "oldPassword": "WrongPassword",
  "newPassword": "Password123!",
  "confirmPassword": "Password123!"
}
> {%
  client.test("Request failed", function() {
    client.assert(response.status === 500, "Response status is not 500");
    client.assert(response.body.error == "Internal Server Error")
  });
%}

