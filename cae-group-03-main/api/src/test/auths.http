### Create producteur account
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "honorific": "M.",
  "firstName": "Producteur",
  "lastName": "Producteur",
  "email": "Producteur@Producteur.be",
  "password": "Mdp.123!",
  "phoneNumber": "3211111111",
  "role": "PRODUCTEUR",
  "company": "",
  "address": {
    "street": "Rue des Producteur",
    "number": "1",
    "box":"1",
    "postalCode": 1000,
    "city": "Producteur",
    "country": {
      "name": "Producteur"
    }
  }
}
> {%
  client.test("Request executed successfully", function() {
    client.assert(response.status === 200, "Response status is not 200");
  });

  client.test("Response content-type is json", function() {
    var type = response.contentType.mimeType;
    client.assert(type === "application/json", "Expected 'application/json' but received '" + type + "'");
  });
  client.test("Should return user data", function() {
    var body = response.body
    console.log(body);
    client.assert(body.email == "Producteur@Producteur.be");
    client.assert(body.firstName == "Producteur" );
    client.assert(body.role == "PRODUCTEUR");
    client.assert(body.token)
  });
%}

